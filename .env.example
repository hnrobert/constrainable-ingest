# ── Deployment configuration ──
# Copy to .env and fill in before `docker compose up -d`

# Required
PUBLIC_HOST=192.168.1.100
SESSION_SECRET=change-me-to-a-long-random-string

# Optional
AUTHMOD_VERIFIER_SECRET=change-me-to-a-long-random-string
# MEDIA_NODE_AUTH_TOKEN=change-me-to-a-long-random-string
TZ=Asia/Shanghai
