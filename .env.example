# ── Deployment configuration ──
# Copy to .env and fill in before `docker compose up -d`

# Required
SESSION_SECRET=change-me-to-a-long-random-string

# Optional
AUTHMOD_VERIFIER_SECRET=change-me-to-a-long-random-string
# WebRTC (WHEP) playback only: public IP for ICE. OBS ingest URLs need NO
# configuration — they are derived from wherever users browse the app.
# PUBLIC_HOST=192.168.1.100
# Media-node identifier (multi-node deployments only)
# NODE_IDENTIFIER=media-node
# WebRTC ICE candidate browsers connect to (default: derived from
# PUBLIC_RTMP_AUTHORITY host; 127.0.0.1 on single-server defaults)
# SRS_RTC_CANDIDATE=203.0.113.10
# WebRTC media UDP port (SRS rtc listen + published port — same number; open
# it in the firewall)
# SRS_UDP_PORT=38000
# ICE servers for admin viewers — STUN now, TURN later. JSON array or comma list:
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
# ICE_SERVERS=stun:stun.l.google.com:19302
# PUBLIC_RTMP_AUTHORITY=node1.example.com # only when tunnel remaps RTMP
# MEDIA_NODE_AUTH_TOKEN=change-me-to-a-long-random-string
TZ=Asia/Shanghai

# Split deployment only (static frontend on another origin, e.g. a CDN):
# frontend origins allowed to make credentialed cross-origin API requests
# (comma-separated). Also switches the session cookie to SameSite=None; Secure
# — requires HTTPS on this server. Leave unset for same-origin deployments.
# The frontend side of the pair is API_ORIGIN at `bun run generate` time —
# see docs/CDN.md Option B.
# CORS_ORIGINS=https://cdn.example.com
