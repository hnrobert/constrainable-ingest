{
  "name": "constrainable-ingest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun ./node_modules/@nuxt/cli/bin/nuxi.mjs dev --port 31954 --host",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "start": "bun .output/server/index.mjs",
    "stress": "bun run scripts/stress-streams.ts",
    "compose:up": "docker compose -f docker/docker-compose.yml up -d --force-recreate --build",
    "compose:up:dev": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml up -d --force-recreate --build srs",
    "compose:down": "docker compose -f docker/docker-compose.yml down",
    "compose:logs": "docker compose -f docker/docker-compose.yml logs -f --tail=100",
    "compose:logs:srs": "docker compose -f docker/docker-compose.yml logs -f --tail=100 srs",
    "gateway": "cd rtmp-gateway && RTMP_LISTEN=:1935 SRS_ADDR=localhost:11935 APP_BASE=http://localhost:31954 RTMP_AUTH_TOKEN=dev-insecure-rtmp-token go run ."
  },
  "trustedDependencies": [],
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@lucide/vue": "^1.31.0",
    "@noble/hashes": "^2.3.0",
    "@tailwindcss/vite": "^4",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "email-poster": "file:../email-poster",
    "jose": "^6.2.8",
    "lucide-vue-next": "^1.0.0",
    "mpegts.js": "^1.8.1",
    "nodemailer": "^9.0.3",
    "nuxt": "^4.5.2",
    "picomatch": "^4.0.5",
    "reka-ui": "^2.10.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/nodemailer": "^8.0.1",
    "@types/picomatch": "^4.0.3",
    "@vueuse/nuxt": "^14.4.0",
    "typescript": "5.8.3",
    "vue-tsc": "^2.2.0"
  }
}
